# Diagramz Production Environment Variables

# Domain for Caddy automated HTTPS (leave as :80 if using raw IP address)
# Example: DOMAIN=api.yourdomain.com
DOMAIN=:80

# Database Connection (If using external PostgreSQL e.g. MonsterASP / DatabaseASP / Neon / Supabase)
# Note: encode special characters in password, e.g. '?' -> '%3F'
# If using the internal MonsterASP host: postgresql://db74181:<password>@db74181.databaseasp.net:5432/db74181?sslmode=disable
# If connecting from external servers/local: postgresql://db74181:<password>@db74181.public.databaseasp.net:5432/db74181?sslmode=disable
# DATABASE_URL=postgresql://...

# Local Docker Database Credentials (fallback if DATABASE_URL is not set)
POSTGRES_USER=diagramz_user
POSTGRES_PASSWORD=replace_with_a_secure_random_db_password
POSTGRES_DB=diagramz

# Security / JWT Secrets (generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace_with_a_64_character_random_hex_string_access
JWT_REFRESH_SECRET=replace_with_a_64_character_random_hex_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (your frontend URL, e.g. https://diagramz.vercel.app or http://localhost:3000)
CORS_ORIGIN=*

# AI Keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cloudflare R2 Storage (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=diagramz-assets
R2_PUBLIC_URL=
