<configuration>
  <system.webServer>
    <!-- Disable native IIS WebSocket module so Socket.IO / WebSockets pass to node without IIS collision -->
    <webSocket enabled="false" />

    <handlers>
      <!-- Handler for NestJS compiled entrypoint -->
      <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Let physical static files through if needed -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="([\S]+[.](jpg|jpeg|gif|png|svg|ico|css|js|txt|html|woff|woff2))" />
          <action type="Rewrite" url="public/{R:1}" />
        </rule>

        <!-- Route all application API and WebSocket traffic into dist/main.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="dist/main.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Configure iisnode runtime parameters -->
    <iisnode
      node_env="production"
      nodeProcessCommandLine="node.exe"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      devErrorsEnabled="true"
      flushResponse="true"
      enableXFF="true"
      loggingEnabled="true"
      logDirectory="iisnode"
      watchedFiles="web.config;*.js;.env"
    />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment=".env" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
        <!-- 50MB payload limit -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- Ensure JSON error responses from NestJS are passed through intact -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
