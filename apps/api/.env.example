PORT=4000
NODE_ENV=development

# Neon PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/diagramz?sslmode=disable"
DATABASE_ADMIN_URL="postgresql://postgres:postgres@localhost:5433/diagramz?sslmode=disable"

# JWT Config
JWT_ACCESS_SECRET="generate-a-minimum-64-char-secret-string-for-diagramz-development-mode"
JWT_REFRESH_SECRET="generate-a-minimum-64-char-refresh-string-for-diagramz-development-mode"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_URL="redis://localhost:6379"

# AI Keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="diagramz-assets"
R2_PUBLIC_URL="https://assets.diagramz.io"

# CORS
CORS_ORIGIN="http://localhost:3000"
